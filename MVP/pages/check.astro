---
import Shell from '../../src/layouts/Shell.astro';
import Brand from '../../src/components/Brand.astro';
import Findings from '../components/Findings.astro';
import { demoBreaches, demoDate } from '../lib/demo.ts';
import { rankBreaches, stepKey, updateProgress, type Progress } from '../lib/findings.ts';
import '../styles.css';

const app = '/app/';
const sampleUrl = '/app/?sample=1';
const sample = Astro.url.searchParams.get('sample') === '1';
const findings = rankBreaches(demoBreaches, demoDate);
const demoCookie = 'koverr_sample_progress';
const cookieOptions = { path: app, httpOnly: true, sameSite: 'strict', secure: Astro.url.protocol === 'https:', maxAge: 3600 } as const;
const stored = Astro.cookies.get(demoCookie)?.value;
let progress: Progress = {};
try {
  const value = stored ? JSON.parse(stored) : null;
  for (const finding of findings.slice(0, 3)) {
    for (const step of finding.steps) {
      const key = stepKey(finding, step);
      const outcome = value?.[key];
      if (typeof outcome?.at !== 'string' || !Number.isFinite(Date.parse(outcome.at))) continue;
      if (outcome.status === 'done' || (outcome.status === 'skipped' && typeof outcome.reason === 'string')) {
        progress[key] = outcome;
      }
    }
  }
} catch {
  // Ignore an unreadable sample cookie.
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
let error = '';
if (Astro.request.method === 'POST') {
  const fields = await Astro.request.formData();
  const intent = fields.get('intent');
  if (sample && intent === 'progress') {
    const updated = updateProgress(findings, progress, fields, new Date().toISOString());
    if (updated) {
      Astro.cookies.set(demoCookie, JSON.stringify(updated), cookieOptions);
      return Astro.redirect(sampleUrl, 303);
    }
    error = 'Choose a valid step. To skip a step, add a short reason.';
    Astro.response.status = 400;
  } else if (sample && intent === 'exit') {
    Astro.cookies.delete(demoCookie, cookieOptions);
    return Astro.redirect(app, 303);
  } else {
    return new Response(null, { status: 400 });
  }
}
---
<Shell title="Free leak check · Koverr" description="Find breaches and take the first fix." noindex>
  <div class="check-app">
    <header class="check-header">
      <div class="wrap check-header-inner">
        <Brand />
        {sample && <form method="post" action={sampleUrl}>
          <button class="check-link">Exit sample</button>
          <input type="hidden" name="intent" value="exit" />
        </form>}
      </div>
    </header>
    <main id="main" class="wrap check-main">
      {error && <p class="check-notice" role="alert">{error}</p>}
      {sample ? (
        <>
          <p class="check-notice">Sample data only. These findings are fictional.</p>
          <Findings findings={findings} progress={progress} checkedAt={demoDate} sample action={sampleUrl} />
        </>
      ) : (
        <section class="check-start" aria-labelledby="check-title">
          <div class="check-intro">
            <p class="check-label">Free leak check</p>
            <h1 id="check-title">Find where your email leaked.</h1>
            <p>See what was exposed in known breaches and get step-by-step fixes for the ones to tackle first.</p>
          </div>
          <div class="check-panel">
            <h2>Try a sample check</h2>
            <p>See what results and fixes look like using fictional breaches.</p>
            <a class="check-button check-primary" href={sampleUrl}>View sample results</a>
          </div>
        </section>
      )}
    </main>
  </div>
</Shell>
