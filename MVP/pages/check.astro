---
import Shell from '../../src/layouts/Shell.astro';
import Brand from '../../src/components/Brand.astro';
import PlanPicker from '../components/PlanPicker.astro';
import { readAccountUseChange, sampleAccountUse, type AccountUseByBreach } from '../lib/account-use.ts';
import { readPlanChoice, type PlanChoice } from '../lib/experiment.ts';
import Findings from '../components/Findings.astro';
import { demoDate } from '../lib/demo.ts';
import { updateProgress } from '../lib/findings.ts';
import { sampleFindings, sampleProgress } from '../lib/sample.ts';
import { liveCheck, liveConfig, normalizeEmail } from '../lib/live.ts';
import '../styles.css';

const app = '/app/';
const sampleUrl = '/app/?sample=1';
const sample = Astro.url.searchParams.get('sample') === '1';
const demoCookie = 'koverr_sample_progress';
const sampleUseCookie = 'koverr_sample_account_use';
const samplePlanCookie = 'koverr_sample_plan';
const tokenCookie = 'koverr_check_session';
const deletedCookie = 'koverr_account_deleted';
const pendingCookie = 'koverr_pending_email';
const config = sample ? null : liveConfig();
const live = config && Astro.url.origin === config.origin ? liveCheck(config) : null;
const cookieOptions = { path: app, httpOnly: true, sameSite: 'strict', secure: Astro.url.protocol === 'https:' } as const;
let progress = sample ? sampleProgress(Astro.cookies.get(demoCookie)?.value) : {};
let accountUse: AccountUseByBreach = sample ? sampleAccountUse(sampleFindings, Astro.cookies.get(sampleUseCookie)?.value) : {};
let planChoice: PlanChoice | undefined = sample ? readPlanChoice(Astro.cookies.get(samplePlanCookie)?.value) : undefined;
let token = Astro.cookies.get(tokenCookie)?.value;
const pendingEmail = normalizeEmail(Astro.cookies.get(pendingCookie)?.value ?? null);
let identity: Awaited<ReturnType<NonNullable<typeof live>['identify']>> = null;
let check: Awaited<ReturnType<NonNullable<typeof live>['read']>>['check'] | undefined;
let error = '';

Astro.response.headers.set('Cache-Control', 'private, no-store');

function showError(message: string, status: number) {
  error = message;
  Astro.response.status = status;
}

function clearSession() {
  Astro.cookies.delete(tokenCookie, cookieOptions);
  Astro.cookies.delete(pendingCookie, cookieOptions);
}

try {
  const isPost = Astro.request.method === 'POST';
  let fields: FormData | undefined;
  if (isPost) {
    const expectedOrigin = sample ? Astro.url.origin : config?.origin;
    if (Astro.request.headers.get('origin') !== expectedOrigin || Astro.url.origin !== expectedOrigin) {
      return new Response(null, { status: 403, headers: { 'Cache-Control': 'no-store' } });
    }
    fields = await Astro.request.formData();
    if (live && fields.get('intent') === 'sign-out') {
      clearSession();
      return Astro.redirect(app, 303);
    }
  }
  if (live && token) {
    identity = await live.identify(token);
    if (!identity) {
      Astro.cookies.delete(tokenCookie, cookieOptions);
      token = undefined;
    }
  }
  if (fields) {
    const intent = fields.get('intent');

    if (sample && intent === 'progress') {
      const updated = updateProgress(sampleFindings, progress, fields, new Date().toISOString());
      if (updated) {
        Astro.cookies.set(demoCookie, JSON.stringify(updated), { ...cookieOptions, maxAge: 3600 });
        return Astro.redirect(sampleUrl, 303);
      }
      showError('Choose a valid step. To skip a step, add a short reason.', 400);
    } else if (sample && intent === 'account-use') {
      const change = readAccountUseChange(sampleFindings, fields);
      if (!change) showError('Choose an answer for one of the listed accounts.', 400);
      else {
        Astro.cookies.set(sampleUseCookie, JSON.stringify({ ...accountUse, [change.id]: change.choice }), { ...cookieOptions, maxAge: 3600 });
        return Astro.redirect(sampleUrl + '#account-use-' + change.index, 303);
      }
    } else if (sample && intent === 'plan-choice') {
      const choice = readPlanChoice(fields.get('choice'));
      if (!choice) showError('Choose one of the listed options.', 400);
      else {
        if (!planChoice) Astro.cookies.set(samplePlanCookie, choice, { ...cookieOptions, maxAge: 3600 });
        return Astro.redirect(sampleUrl + '#plan-title', 303);
      }
    } else if (sample && intent === 'exit') {
      Astro.cookies.delete(samplePlanCookie, cookieOptions);
      Astro.cookies.delete(sampleUseCookie, cookieOptions);
      Astro.cookies.delete(demoCookie, cookieOptions);
      return Astro.redirect(app, 303);
    } else if (live && !identity && (intent === 'send' || intent === 'resend')) {
      const email = intent === 'send' ? normalizeEmail(fields.get('email')) : pendingEmail;
      if (!email) showError('Enter a valid email address.', 400);
      else {
        const sent = await live.sendCode(email);
        if (sent === 'limited') showError('You’ve reached the code request limit. Wait before asking for another code.', 429);
        else {
          Astro.cookies.set(pendingCookie, email, { ...cookieOptions, maxAge: 600 });
          return Astro.redirect(app, 303);
        }
      }
    } else if (live && !identity && intent === 'change-email') {
      Astro.cookies.delete(pendingCookie, cookieOptions);
      return Astro.redirect(app, 303);
    } else if (live && !identity && intent === 'verify') {
      const code = fields.get('code');
      const session = pendingEmail && typeof code === 'string' && /^\d{6}$/.test(code)
        ? await live.verifyCode(pendingEmail, code)
        : null;
      if (!session) showError('That code could not be verified. Check it or request a new one.', 400);
      else {
        Astro.cookies.set(tokenCookie, session.token, { ...cookieOptions, maxAge: Math.min(session.expiresIn, 3600) });
        Astro.cookies.delete(pendingCookie, cookieOptions);
        return Astro.redirect(app, 303);
      }
    } else if (live && identity && token) {
      if (intent === 'scan') {
        await live.scan(token);
        return Astro.redirect(app, 303);
      }
      if (intent === 'plan-choice') {
        const choice = readPlanChoice(fields.get('choice'));
        if (choice && await live.choosePlan(identity, choice)) return Astro.redirect(app + '#plan-title', 303);
        showError('Choose a listed option after opening your results.', 400);
      } else if (intent === 'delete') {
        if (fields.get('confirmation') === 'DELETE') {
          await live.deleteAccount(identity);
          clearSession();
          Astro.cookies.set(deletedCookie, '1', { ...cookieOptions, maxAge: 30 });
          return Astro.redirect(app, 303);
        }
        showError('Type DELETE to confirm account deletion.', 400);
      } else if (intent === 'progress' || intent === 'account-use' || intent === 'export') {
        ({ check, progress } = await live.read(token, identity));
        if (intent === 'export') {
          return new Response(JSON.stringify({
            account: { id: identity.id, email: identity.email, emailVerifiedAt: identity.verifiedAt },
            check: check ?? null,
            fixProgress: progress,
            breachedAccountUse: await live.readAccountUse(token, identity),
            experimentEvents: await live.readEvents(token, identity),
          }, null, 2), {
            headers: {
              'Content-Type': 'application/json; charset=utf-8',
              'Content-Disposition': 'attachment; filename="koverr-export.json"',
              'Cache-Control': 'private, no-store',
              'X-Content-Type-Options': 'nosniff',
            },
          });
        }
        if (intent === 'account-use') {
          const change = check?.state === 'complete' && readAccountUseChange(check.findings, fields);
          if (change) {
            await live.saveAccountUse(identity, change.id, change.choice);
            return Astro.redirect(app + '#account-use-' + change.index, 303);
          }
          showError('Choose an answer for one of the listed accounts.', 400);
        } else {
          if (check?.state === 'complete' && await live.saveProgress(identity, check.findings, fields)) {
            return Astro.redirect(app, 303);
          }
          showError('Choose a valid step. To skip a step, add a short reason.', 400);
        }
      } else {
        showError('That action is unavailable.', 400);
      }
    } else {
      showError('Sign in to continue or open the sample check.', 400);
    }
  }

  if (live && identity && token && !check) ({ check, progress } = await live.read(token, identity));
  if (live && identity && token && check?.state === 'complete') {
    accountUse = Object.fromEntries((await live.readAccountUse(token, identity)).map(({ breach_id, choice }) => [breach_id, choice]));
  }
  if (live && identity && token && !isPost) {
    const events = await live.readEvents(token, identity);
    if (!events.some((event) => event.event_name === 'email_verified')) await live.recordEvent(identity, 'email_verified');
    if (check?.state === 'complete' && !events.some((event) => event.event_name === 'results_seen')) {
      await live.recordEvent(identity, 'results_seen');
    }
    planChoice = readPlanChoice(events.find((event) => event.event_name === 'plan_choice')?.choice);
  }
} catch {
  showError('Koverr could not finish that action. Please try again shortly.', 503);
}

const maskedEmail = pendingEmail ? pendingEmail.replace(/^(.).*(@.*)$/, '$1•••$2') : '';
const canRetry = !check || Date.now() - Date.parse(check.attempted_at) >= 60_000;
const deleted = !identity && !sample && Astro.cookies.get(deletedCookie)?.value === '1';
if (deleted) Astro.cookies.delete(deletedCookie, cookieOptions);
---
<Shell title="Free leak check · Koverr" description="Find breaches and take the first fix." noindex referrerPolicy="same-origin">
  <div class="check-app">
    <header class="check-header">
      <div class="wrap check-header-inner">
        <Brand />
        {(sample || identity) && <form method="post" action={sample ? sampleUrl : app}>
          <button class="check-link">{sample ? 'Exit sample' : 'Sign out'}</button>
          <input type="hidden" name="intent" value={sample ? 'exit' : 'sign-out'} />
        </form>}
      </div>
    </header>
    <main id="main" class="wrap check-main">
      {error && <p class="check-notice" role="alert">{error}</p>}
      {deleted && <p class="check-notice" role="status">Your Koverr account was deleted.</p>}
      {sample ? (
        <>
          <p class="check-notice">Sample data only. These findings are fictional.</p>
          <Findings findings={sampleFindings} progress={progress} accountUse={accountUse} checkedAt={demoDate} sample action={sampleUrl} />
          <PlanPicker action={sampleUrl} choice={planChoice} />
          <p><a href="/app/inventory/">Try the account inventory</a></p>
        </>
      ) : identity ? (
        <>
          {check?.state === 'complete' && check.checked_at ? (
            <>
              <Findings findings={check.findings} progress={progress} accountUse={accountUse} checkedAt={check.checked_at} sample={false} action={app} />
              <PlanPicker choice={planChoice} />
            </>
          ) : (
            <section class="check-panel check-ready">
              <h1>{check?.state === 'failed' ? 'The check could not be completed.' : 'Check your verified email.'}</h1>
              <p class="check-meta">{identity.email}</p>
              <p>We send this address to <a href="https://haveibeenpwned.com/">Have I Been Pwned</a> to look for known breaches.</p>
              {canRetry ? (
                <form method="post" action={app}>
                  <button class="check-button check-primary" name="intent" value="scan">{check ? 'Try again' : 'Run breach check'}</button>
                </form>
              ) : <p>{check?.state === 'checking' ? 'A check just started.' : 'The breach index did not return results.'} <a href={app}>Refresh</a> after a minute to check again.</p>}
            </section>
          )}
          <details class="check-other check-account">
            <summary>Account and data</summary>
            <p>Signed in as {identity.email}. <a href="/app/privacy/">MVP privacy notice</a></p>
            <form method="post" action={app}>
              <button class="check-button" name="intent" value="export">Export account data</button>
            </form>
            <details class="check-delete">
              <summary>Delete account</summary>
              <form method="post" action={app} class="check-panel">
                <p>This permanently deletes your sign-in, saved check and fix progress from the active app.</p>
                <div>
                  <label for="confirmation">Type DELETE to confirm</label>
                  <input id="confirmation" name="confirmation" required autocomplete="off" />
                </div>
                <button class="check-button" name="intent" value="delete">Permanently delete account</button>
              </form>
            </details>
          </details>
        </>
      ) : (
        <section class="check-start" aria-labelledby="check-title">
          <div class="check-intro">
            <p class="check-label">Free leak check</p>
            <h1 id="check-title">Find where your email leaked.</h1>
            <p>See what was exposed in known breaches and get step-by-step fixes for the ones to tackle first.</p>
          </div>
          <div class="check-panel">
            {live && pendingEmail ? (
              <>
                <h2>Enter your verification code</h2>
                <p>Check the inbox for {maskedEmail}.</p>
                <form method="post" action={app}>
                  <label for="code">Six-digit code</label>
                  <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
                  <button class="check-button check-primary" name="intent" value="verify">Verify email</button>
                </form>
                <form method="post" action={app} class="check-controls">
                  <button class="check-link" name="intent" value="resend">Send another code</button>
                  <button class="check-link" name="intent" value="change-email">Use another email</button>
                </form>
              </>
            ) : live ? (
              <>
                <h2>Verify your email</h2>
                <p>We’ll email you a code to confirm the address is yours.</p>
                <form method="post" action={app}>
                  <label for="email">Email address</label>
                  <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
                  <button class="check-button check-primary" name="intent" value="send">Send verification code</button>
                </form>
                <p class="check-meta"><a href="/app/privacy/">MVP privacy notice</a></p>
              </>
            ) : (
              <>
                <h2>Try a sample check</h2>
                <p>See what results and fixes look like using fictional breaches.</p>
                <p class="check-meta"><a href="/app/inventory/">Try the account inventory</a></p>
              </>
            )}
            <a class:list={['check-button', { 'check-primary': !live }]} href={sampleUrl}>View sample results</a>
            {!pendingEmail && <p class="check-meta"><a href="/app/password/">Check a password in your browser</a></p>}
          </div>
        </section>
      )}
    </main>
  </div>
</Shell>
