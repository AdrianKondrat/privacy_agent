---
import Shell from '../../src/layouts/Shell.astro';
import Brand from '../../src/components/Brand.astro';
import '../styles.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Content-Security-Policy', "connect-src https://api.pwnedpasswords.com; form-action 'none'; frame-ancestors 'none'; base-uri 'none'");
---
<Shell title="Check a password · Koverr" description="Check a password against known breaches from your browser." noindex referrerPolicy="no-referrer">
  <div class="check-app">
    <header class="check-header">
      <div class="wrap check-header-inner"><Brand /><a class="check-link" href="/app/">Back to leak check</a></div>
    </header>
    <main id="main" class="wrap check-main">
      <div class="check-start">
        <section class="check-intro" aria-labelledby="password-title">
          <h1 id="password-title">Check a password.</h1>
          <p>See whether it appears in known breaches. Your browser sends the first five characters of a hash to <a href="https://haveibeenpwned.com/Passwords">Pwned Passwords</a> and compares the results on this device.</p>
          <p class="check-meta"><a href="/app/privacy/">MVP privacy notice</a></p>
        </section>
        <div class="check-panel">
          <form id="password-check" autocomplete="off">
            <fieldset disabled>
              <legend class="visually-hidden">Password check</legend>
              <label for="range-password">Password to check</label>
              <input id="range-password" type="password" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="1024" required />
              <button type="submit" class="check-button check-primary">Check password</button>
            </fieldset>
            <p id="password-result" role="status" aria-atomic="true"></p>
          </form>
          <noscript><p>Enable JavaScript to check a password on this device.</p></noscript>
        </div>
      </div>
    </main>
  </div>
</Shell>

<script>
  import { checkPassword } from '../lib/password-range.ts';

  const form = document.querySelector<HTMLFormElement>('#password-check');
  const input = form?.querySelector<HTMLInputElement>('#range-password');
  const controls = form?.querySelector('fieldset');
  const result = document.querySelector('#password-result');

  if (form && input && controls && result) {
    if (!window.isSecureContext || !crypto.subtle) {
      result.textContent = 'Open this page over HTTPS to check a password.';
    } else {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (controls.disabled || !input.value) return;
        const pending = checkPassword(input.value);
        input.value = '';
        controls.disabled = true;
        result.textContent = 'Checking…';
        const outcome = await pending;
        const messages = {
          found: 'This password appears in known breaches. Replace it everywhere you use it with a unique password.',
          absent: 'This password did not appear in the source we checked. Keep it unique to one account.',
          unavailable: 'The password check could not be completed. Try again shortly.',
        };
        result.textContent = messages[outcome];
        controls.disabled = false;
      });
      controls.disabled = false;
    }
  }
</script>
