---
import Shell from '../../src/layouts/Shell.astro';
import InventoryBoard from '../components/InventoryBoard.astro';
import Brand from '../../src/components/Brand.astro';
import '../styles.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Content-Security-Policy', "connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'");
---
<Shell title="Account inventory · Koverr" description="Review a list of account domains on this device." noindex referrerPolicy="no-referrer">
  <meta slot="head" http-equiv="Content-Security-Policy" content="connect-src 'none'; form-action 'none'; base-uri 'none'" />
  <div class="check-app">
    <header class="check-header">
      <div class="wrap check-header-inner"><Brand /><a class="check-link" href="/app/">Back to leak check</a></div>
    </header>
    <main id="main" class="wrap check-main">
      <InventoryBoard />
    </main>
  </div>
</Shell>
