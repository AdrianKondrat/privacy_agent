# Live mode is available only at this origin, with all settings configured.
KOVERR_APP_ORIGIN=http://127.0.0.1:4327
KOVERR_SUPABASE_URL=
KOVERR_SUPABASE_PUBLISHABLE_KEY=
# Keep the server secret in the host secret store.
KOVERR_SUPABASE_SECRET_KEY=
# Existing installs can use KOVERR_SUPABASE_SERVICE_ROLE_KEY for a legacy JWT.
KOVERR_HIBP_API_KEY=

# Optional comma-separated Supabase Auth user UUIDs for founder review.
KOVERR_CONCIERGE_REVIEWER_IDS=

# Use invite-only for the launch-list pilot. Set open when expanding access.
KOVERR_PILOT_MODE=invite-only
