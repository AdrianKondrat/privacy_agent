# Optional locally. For deployment, use an absolute path on persistent storage.
# WAITLIST_DB_PATH=/path/to/data/waitlist.sqlite
# Set a working inbox before publishing. This appears on the privacy page.
# WAITLIST_CONTACT=hello@your-domain.example
# Set to the exact public origin when deploying behind a reverse proxy.
# WAITLIST_ORIGIN=https://your-domain.example
